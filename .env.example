# Copy to .env and adjust. Contains no secrets: those live in secrets/ (see `aiplat secrets init`).

# Image versions. Pin these to exact tags you have tested; bump them deliberately.
OLLAMA_IMAGE=ollama/ollama:0.6.8
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LANGFUSE_IMAGE=langfuse/langfuse:2
POSTGRES_IMAGE=postgres:16-alpine

# Open-source models pulled by the ollama-init job (space-separated Ollama tags).
PLATFORM_MODELS=qwen2.5:0.5b llama3.2:1b
